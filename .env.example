# ==============================================================================
# Spotter Environment Configuration Example
# ==============================================================================
# Copy this file to .env and provide your actual secrets.
# Never commit real credentials to version control.
# ==============================================================================

# Database connection string (server-only)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=

# AI Model Layer (Gemini Free Tier - Routing, classification, embeddings)
GEMINI_API_KEY=

# Payment Gateway (Flutterwave)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Auth / Session Encryption Secret
SESSION_SECRET=
# Optional: Staff Session Encryption Secret (falls back to SESSION_SECRET if unset)
# STAFF_SESSION_SECRET=

# Email Service (Nodemailer / SMTP)
# Leave SMTP_USER and SMTP_PASS empty to use local mock transport in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Spotter Gym <noreply@spottergym.com>"
